# -----------------------------------------------------------------------------
# Databricks Authentication (Required)
# -----------------------------------------------------------------------------
# You must provide either a Token OR Service Principal credentials.

# Option 1: Personal Access Token (PAT) Auth
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# Option 2: Service Principal Auth (OAuth M2M)
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_CLIENT_ID=client-id-uuid
# DATABRICKS_CLIENT_SECRET=client-secret-value


# -----------------------------------------------------------------------------
# Open Policy Agent (OPA) Configuration (Optional)
# -----------------------------------------------------------------------------
# The app will automatically download a static OPA binary if these are left blank.

# If you are running an OPA server elsewhere, provide the URL:
# OPA_URL=http://localhost:8181

# If you have OPA installed globally (e.g. via Homebrew) and want to use it:
# USE_LOCAL_BINARY=true
# OPA_BINARY=/usr/local/bin/opa

# Directory where .rego policies are stored (defaults to 'policies')
POLICIES_DIR=policies


# -----------------------------------------------------------------------------
# Application Configuration (Optional)
# -----------------------------------------------------------------------------
# DATABASE_URL=sqlite:///atlas_hub.db
# PROJECT_NAME=policy-enforcement-sentinel
# API_V1_PREFIX=/api/v1
# CORS_ORIGINS=*

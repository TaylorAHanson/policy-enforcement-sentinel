    "owner": "svc-etl",
    "active": true,
    "application_id": "abc-123",
    "entitlements": [
      "allow-cluster-create"
    ],
    "roles": [
      "account_admin"
    ],
    "tags": {}
  },
  "expect": {
    "fires": [
      "SEC-SPN-002"
    ],
    "passes": [
      "CTL-SPN-003",
      "SEC-SPN-001",
      "SEC-SPN-004"
    ]
  }
}
